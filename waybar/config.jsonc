{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/clipboard",
        "tray",
        "pulseaudio",
        "backlight",
        "network",
        "bluetooth",
        "battery",
        "cpu",
        "memory",
        "temperature",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "\uf0c9",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": false,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 42,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "on-click": "alacritty -e calcurse"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },

    "backlight": {
        "device": "amdgpu_bl1",
        "format": "\uf185 {percent}%",
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "network": {
        "format-wifi": "\uf1eb {signalStrength}%",
        "format-ethernet": "\uf0ac",
        "format-disconnected": "\uf1eb offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "\uf293",
        "format-disabled": "\uf293",
        "format-connected": "\uf293 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "on-click": "blueman-manager"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo}\n{capacity}%"
    },

    "cpu": {
        "format": "\uf2db {usage}%",
        "interval": 3,
        "on-click": "alacritty -e top"
    },

    "memory": {
        "format": "\uf538 {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        "format": "\uf2c9 {temperatureC}°C",
        "critical-threshold": 85,
        "interval": 5
    },

    "custom/clipboard": {
        "format": "\uf0ea {}",
        "exec": "cliphist list | wc -l",
        "interval": 10,
        "tooltip": false,
        "on-click": "$HOME/.local/bin/hypr-clipboard"
    },

    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/hypr-power-menu"
    }
}

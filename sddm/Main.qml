/***************************************************************************
 * Hyprsimple SDDM Dynamic Theme
 * Asymmetric layout: login panel left, wallpaper right
 * Colors and wallpaper synchronized from active Hyprsimple theme
 * DO NOT EDIT - Generated by sddm-theme-sync
 ***************************************************************************/

import QtQuick 2.15
import SddmComponents 2.0

Rectangle {
    id: container
    anchors.fill: parent

    LayoutMirroring.enabled: Qt.locale().textDirection == Qt.RightToLeft
    LayoutMirroring.childrenInherit: true

    property int sessionIndex: 0

    TextConstants { id: textConstants }

    Connections {
        target: sddm

        function onLoginSucceeded() {
            errorMessage.color = @@SUCCESS@@
            errorMessage.text = textConstants.loginSucceeded
        }
        function onLoginFailed() {
            password.text = ""
            errorMessage.color = @@DANGER@@
            errorMessage.text = textConstants.loginFailed
        }
        function onInformationMessage(message) {
            errorMessage.color = @@INFO@@
            errorMessage.text = message
        }
    }

    // Background - full screen wallpaper
    Background {
        anchors.fill: parent
        source: Qt.resolvedUrl(config.background)
        fillMode: Image.PreserveAspectCrop
        onStatusChanged: {
            var defaultBackground = Qt.resolvedUrl(config.defaultBackground)
            if (status == Image.Error && source != defaultBackground) {
                source = defaultBackground
            }
        }
    }

    // Dark overlay for text readability
    Rectangle {
        anchors.fill: parent
        color: @@BACKGROUND@@
        opacity: 0.55
    }

    // Clock at top-right
    Clock {
        id: clock
        anchors.top: parent.top
        anchors.right: parent.right
        anchors.margins: 24
        color: @@FOREGROUND@@
        timeFont.family: "JetBrainsMono Nerd Font Mono"
        timeFont.pixelSize: 28
        dateFont.family: "JetBrainsMono Nerd Font Mono"
        dateFont.pixelSize: 12
    }

    // Left login panel (glass: translucent dark fill; no native blur because
    // QtGraphicalEffects is not installed in this Qt/SDDM runtime)
    Rectangle {
        id: loginPanel
        width: Math.min(300, parent.width * 0.25)
        height: mainColumn.implicitHeight + 60
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        anchors.leftMargin: Math.max(24, parent.width * 0.03)
        radius: 14
        color: "transparent"
        clip: true

        // Translucent glass fill (safe fallback when real blur is unavailable)
        Rectangle {
            anchors.fill: parent
            radius: 14
            color: @@SURFACE@@
            opacity: 0.48
        }

        Column {
            id: mainColumn
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.margins: 20
            spacing: 12

            // Welcome heading
            Text {
                id: welcomeText
                width: parent.width
                color: @@FOREGROUND@@
                text: textConstants.welcomeText.arg(sddm.hostName)
                wrapMode: Text.WordWrap
                font.pixelSize: 20
                font.weight: Font.Medium
                elide: Text.ElideRight
                horizontalAlignment: Text.AlignLeft
            }

            // Date display (below welcome)
            Text {
                id: dateText
                width: parent.width
                color: @@MUTED@@
                text: {
                    var d = new Date();
                    return d.toLocaleDateString(Qt.locale(), { weekday: "long", year: "numeric", month: "long", day: "numeric" });
                }
                font.pixelSize: 13
                horizontalAlignment: Text.AlignLeft
            }

            // Username field
            Column {
                width: parent.width
                spacing: 6
                Text {
                    text: textConstants.userName
                    color: @@FOREGROUND@@
                    font.bold: true
                    font.pixelSize: 13
                }
                TextBox {
                    id: name
                    width: parent.width; height: 34
                    text: userModel.lastUser
                    font.pixelSize: 15
                    textColor: @@FOREGROUND@@
                    color: @@SURFACE@@
                    borderColor: @@MUTED@@
                    focusColor: @@ACCENT@@
                    hoverColor: @@ACCENT_DIM@@
                    radius: 12
                    KeyNavigation.tab: password

                    Keys.onPressed: function (event) {
                        if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                            sddm.login(name.text, password.text, sessionIndex)
                            event.accepted = true
                        } else if (event.key === Qt.Key_Backtab) {
                            if (hibernateButton.visible) hibernateButton.forceActiveFocus();
                            else if (suspendButton.visible) suspendButton.forceActiveFocus();
                            else rebootButton.forceActiveFocus();
                            event.accepted = true
                        }
                    }
                }
            }

            // Password field
            Column {
                width: parent.width
                spacing: 6
                Text {
                    text: textConstants.password
                    color: @@FOREGROUND@@
                    font.bold: true
                    font.pixelSize: 13
                }
                PasswordBox {
                    id: password
                    width: parent.width; height: 34
                    font.pixelSize: 15
                    textColor: @@FOREGROUND@@
                    color: @@SURFACE@@
                    borderColor: @@MUTED@@
                    focusColor: @@ACCENT@@
                    hoverColor: @@ACCENT_DIM@@
                    radius: 12
                    KeyNavigation.backtab: name; KeyNavigation.tab: loginButton

                    Keys.onPressed: function (event) {
                        if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                            sddm.login(name.text, password.text, sessionIndex)
                            event.accepted = true
                        }
                    }
                }
            }

            // Error/info message area
            Text {
                id: errorMessage
                width: parent.width
                text: textConstants.prompt
                color: @@MUTED@@
                font.pixelSize: 12
                wrapMode: Text.WordWrap
                horizontalAlignment: Text.AlignHCenter
            }

            // Login button
            Button {
                id: loginButton
                width: parent.width
                height: 34
                text: textConstants.login
                font.pixelSize: 14
                font.bold: true
                textColor: @@FOREGROUND@@
                color: @@ACCENT@@
                activeColor: @@ACCENT_DIM@@
                pressedColor: @@SURFACE@@
                borderColor: @@ACCENT@@
                radius: 10
                onClicked: sddm.login(name.text, password.text, sessionIndex)
                KeyNavigation.backtab: password; KeyNavigation.tab: shutdownButton
            }

            // System controls row - icon buttons (30x30 clickable, ~17px icons)
            Row {
                spacing: 10
                anchors.horizontalCenter: parent.horizontalCenter

                // Shutdown
                Item {
                    id: shutdownButton
                    width: 30
                    height: 30

                    Text {
                        id: shutdownIcon
                        anchors.centerIn: parent
                        font.pixelSize: 23
                        font.family: "JetBrainsMono Nerd Font Mono"
                        color: (shutdownMouse.containsMouse || shutdownButton.activeFocus) ? @@ACCENT@@ : @@FOREGROUND@@
                        text: "⏻"
                    }

                    // Tooltip: Shutdown
                    Text {
                        id: shutdownTip
                        text: textConstants.shutdown
                        visible: shutdownMouse.containsMouse || shutdownButton.activeFocus
                        anchors.bottom: parent.top
                        anchors.bottomMargin: -6
                        anchors.horizontalCenter: parent.horizontalCenter
                        color: @@FOREGROUND@@
                        font.pixelSize: 10
                    }

                    MouseArea {
                        id: shutdownMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        acceptedButtons: Qt.LeftButton
                        onClicked: sddm.powerOff()
                    }

                    KeyNavigation.tab: rebootButton; KeyNavigation.backtab: loginButton
                    Keys.onPressed: function (event) {
                        if (event.key === Qt.Key_Return || event.key === Qt.Key_Space) {
                            sddm.powerOff()
                            event.accepted = true
                        } else if (event.key === Qt.Key_Tab) {
                            if (rebootButton.visible) rebootButton.forceActiveFocus();
                            else if (suspendButton.visible) suspendButton.forceActiveFocus();
                            else if (hibernateButton.visible) hibernateButton.forceActiveFocus();
                            else name.forceActiveFocus();
                            event.accepted = true
                        } else if (event.key === Qt.Key_Backtab) {
                            loginButton.forceActiveFocus();
                            event.accepted = true
                        }
                    }
                }

                // Reboot
                Item {
                    id: rebootButton
                    width: 30
                    height: 30

                    Text {
                        id: rebootIcon
                        anchors.centerIn: parent
                        font.pixelSize: 23
                        font.family: "JetBrainsMono Nerd Font Mono"
                        color: (rebootMouse.containsMouse || rebootButton.activeFocus) ? @@ACCENT@@ : @@FOREGROUND@@
                        text: "↻"
                    }

                    // Tooltip: Reboot
                    Text {
                        id: rebootTip
                        text: textConstants.reboot
                        visible: rebootMouse.containsMouse || rebootButton.activeFocus
                        anchors.bottom: parent.top
                        anchors.bottomMargin: -6
                        anchors.horizontalCenter: parent.horizontalCenter
                        color: @@FOREGROUND@@
                        font.pixelSize: 10
                    }

                    MouseArea {
                        id: rebootMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        acceptedButtons: Qt.LeftButton
                        onClicked: sddm.reboot()
                    }

                    KeyNavigation.tab: suspendButton; KeyNavigation.backtab: shutdownButton
                    Keys.onPressed: function (event) {
                        if (event.key === Qt.Key_Return || event.key === Qt.Key_Space) {
                            sddm.reboot()
                            event.accepted = true
                        } else if (event.key === Qt.Key_Tab) {
                            if (suspendButton.visible) suspendButton.forceActiveFocus();
                            else if (hibernateButton.visible) hibernateButton.forceActiveFocus();
                            else name.forceActiveFocus();
                            event.accepted = true
                        } else if (event.key === Qt.Key_Backtab) {
                            shutdownButton.forceActiveFocus();
                            event.accepted = true
                        }
                    }
                }

                // Suspend
                Item {
                    id: suspendButton
                    width: 30
                    height: 30
                    visible: sddm.canSuspend

                    Text {
                        id: suspendIcon
                        anchors.centerIn: parent
                        font.pixelSize: 23
                        font.family: "JetBrainsMono Nerd Font Mono"
                        color: (suspendMouse.containsMouse || suspendButton.activeFocus) ? @@ACCENT@@ : @@FOREGROUND@@
                        text: "☾"
                    }

                    // Tooltip: Suspend
                    Text {
                        id: suspendTip
                        text: textConstants.suspend
                        visible: suspendMouse.containsMouse || suspendButton.activeFocus
                        anchors.bottom: parent.top
                        anchors.bottomMargin: -6
                        anchors.horizontalCenter: parent.horizontalCenter
                        color: @@FOREGROUND@@
                        font.pixelSize: 10
                    }

                    MouseArea {
                        id: suspendMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        acceptedButtons: Qt.LeftButton
                        onClicked: sddm.suspend()
                    }

                    KeyNavigation.tab: hibernateButton; KeyNavigation.backtab: rebootButton
                    Keys.onPressed: function (event) {
                        if (event.key === Qt.Key_Return || event.key === Qt.Key_Space) {
                            sddm.suspend()
                            event.accepted = true
                        } else if (event.key === Qt.Key_Tab) {
                            if (hibernateButton.visible) hibernateButton.forceActiveFocus();
                            else name.forceActiveFocus();
                            event.accepted = true
                        } else if (event.key === Qt.Key_Backtab) {
                            rebootButton.forceActiveFocus();
                            event.accepted = true
                        }
                    }
                }

                // Hibernate
                Item {
                    id: hibernateButton
                    width: 30
                    height: 30
                    visible: sddm.canHibernate

                    Text {
                        id: hibernateIcon
                        anchors.centerIn: parent
                        font.pixelSize: 23
                        font.family: "JetBrainsMono Nerd Font Mono"
                        color: (hibernateMouse.containsMouse || hibernateButton.activeFocus) ? @@ACCENT@@ : @@FOREGROUND@@
                        text: "❄"
                    }

                    // Tooltip: Hibernate
                    Text {
                        id: hibernateTip
                        text: textConstants.hibernate
                        visible: hibernateMouse.containsMouse || hibernateButton.activeFocus
                        anchors.bottom: parent.top
                        anchors.bottomMargin: -6
                        anchors.horizontalCenter: parent.horizontalCenter
                        color: @@FOREGROUND@@
                        font.pixelSize: 10
                    }

                    MouseArea {
                        id: hibernateMouse
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        acceptedButtons: Qt.LeftButton
                        onClicked: sddm.hibernate()
                    }

                    KeyNavigation.tab: name; KeyNavigation.backtab: suspendButton
                    Keys.onPressed: function (event) {
                        if (event.key === Qt.Key_Return || event.key === Qt.Key_Space) {
                            sddm.hibernate()
                            event.accepted = true
                        } else if (event.key === Qt.Key_Tab) {
                            name.forceActiveFocus();
                            event.accepted = true
                        } else if (event.key === Qt.Key_Backtab) {
                            if (suspendButton.visible) suspendButton.forceActiveFocus();
                            else rebootButton.forceActiveFocus();
                            event.accepted = true
                        }
                    }
                }
            }
        }
    }

    Component.onCompleted: {
        if (name.text == "")
            name.focus = true
        else
            password.focus = true
    }
}

#!/usr/bin/env bash
# hypr-toggle-waybar — Toggle Waybar visibility
# Dependencies: waybar

set -euo pipefail

# Check if Waybar is running
if ! pgrep -x waybar >/dev/null 2>&1; then
    # Waybar not running, start it (same pattern as autostart)
    waybar &
    exit 0
fi

# Waybar is running: toggle visibility via SIGUSR1
pkill -USR1 -x waybar 2>/dev/null || true

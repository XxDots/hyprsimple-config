#!/usr/bin/env bash
# hypr-wallpaper — Random wallpaper setter using hyprctl hyprpaper
# Dependencies: hyprctl, jq

set -euo pipefail

WALLPAPER_DIR="${HOME}/Pictures/wallpapers"
MONITOR="eDP-1"
FIT_MODE="cover"

# Get list of image files
mapfile -t WALLPAPERS < <(find "${WALLPAPER_DIR}" -maxdepth 1 -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.webp" \) | sort)

# No images found
if [[ ${#WALLPAPERS[@]} -eq 0 ]]; then
    exit 0
fi

# Pick random wallpaper
RANDOM_INDEX=$((RANDOM % ${#WALLPAPERS[@]}))
WALLPAPER="${WALLPAPERS[RANDOM_INDEX]}"

# Get monitor name (default to eDP-1 if not found)
MONITOR=$(hyprctl -j monitors 2>/dev/null | jq -r '.[0].name // "eDP-1"')

# Set wallpaper using hyprctl
hyprctl hyprpaper wallpaper "${MONITOR},${WALLPAPER},cover"